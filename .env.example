# Admin
ADMIN_PASSWORD=change-me

# Sessions (any long random string; regenerate for production)
SESSION_SECRET=

# GitHub — reads difficulty labels off submitted pull requests.
# Without a token the whole server shares 60 lookups/hour; with one, 5000.
# A classic token with no scopes is enough for public repositories.
GITHUB_TOKEN=

# Database — libSQL. A local file in development, Turso in production.
#   local:      file:data.db
#   production: libsql://your-db-name-you.turso.io  (+ the auth token below)
TURSO_DATABASE_URL=file:data.db
TURSO_AUTH_TOKEN=

# App
PORT=3000
