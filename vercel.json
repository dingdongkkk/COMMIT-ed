{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(app\\.css|fx\\.js|badge\\.js)", "dest": "/public/$1" },
    { "src": "/badges/(.*)", "dest": "/public/badges/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
